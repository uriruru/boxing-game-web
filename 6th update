<!-- Bulma removed: this section is fully self-contained to prevent global CSS/font conflicts. -->

<style>
  .reibox-wrap{
    --reibox-ink:#f4f4f4;
    --reibox-p1:#e0555a;
    --reibox-p2:#4f8ff0;
  }

  .reibox-wrap,
  .reibox-wrap * {
    box-sizing:border-box;
  }

  .reibox-wrap{
    display:flex;
    justify-content:center;
    padding:20px 12px;
    background:#e8e4da;
    font-family:'Courier New', monospace;
    font-size:16px;
    box-sizing:border-box;
  }

  .reibox-frame{
    position:relative;
    width:100%;
    max-width:800px;
    border-radius:6px;
    overflow:hidden;
    box-shadow:0 12px 40px rgba(0,0,0,0.18);
    line-height:0;
  }

  .reibox-wrap #reibox-ring{
    display:block;
    background:#e8e4da;
    width:100%;
    height:auto;
  }

  /* ---- HUD overlay, drawn directly on top of the canvas ---- */
  .reibox-hud{
    position:absolute;
    top:10px;
    left:10px;
    right:10px;
    display:flex;
    align-items:center;
    gap:10px;
    pointer-events:none;
  }

  .reibox-bar{ flex:1; }

  .reibox-track{
    height:9px;
    background:rgba(0,0,0,0.18);
    border:1px solid rgba(0,0,0,0.25);
    border-radius:2px;
    overflow:hidden;
  }

  .reibox-fill{
    height:100%;
    transition:width 0.15s ease-out;
  }

  .reibox-fill-p1{ background:var(--reibox-p1); }
  .reibox-fill-p2{ background:var(--reibox-p2); }

  .reibox-wrap .reibox-bar.p2 .reibox-track{ direction:rtl; }

  .reibox-wrap #reibox-timer{
    color:#3a3a3a;
    font-size:0.85rem;
    min-width:26px;
    text-align:center;
  }

  /* ---- End-of-round overlay ---- */
  .reibox-msg{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    text-align:center;
    pointer-events:none;
  }

  .reibox-text{
    color:#2b2b2b;
    font-size:1.3rem;
    margin:0 0 10px 0;
    text-shadow:0 1px 6px rgba(255,255,255,0.8);
  }

  .reibox-restart{
    display:none;
    pointer-events:auto;
    border:1px solid rgba(0,0,0,.22);
    border-radius:4px;
    padding:6px 10px;
    background:#fff;
    color:#222;
    font:600 12px/1.2 'Courier New', monospace;
    cursor:pointer;
  }

  .reibox-restart:hover{
    background:#f1f1f1;
  }

  .reibox-loading{
    color:#5a5a5a;
    font-size:0.85rem;
  }

  /* ---- Touch controls, overlaid on the canvas itself ---- */
  .reibox-touch{
    display:none;
    position:absolute;
    left:0;
    right:0;
    bottom:-32px;
    justify-content:space-between;
    align-items:flex-end;
    padding:0 10px;
    pointer-events:none;
  }

  .reibox-top-actions{
    position:absolute;
    top:22px;
    right:12px;
    display:flex;
    gap:7px;
    z-index:5;
    pointer-events:none;
  }

  .reibox-top-actions .reibox-btn{
    position:relative;
    left:auto !important;
    top:auto !important;
  }

  @media (hover:none) and (pointer:coarse), (max-width:680px){
    .reibox-touch{ display:flex; }
  }

  .reibox-cluster{
    position:relative;
    width:88px;
    height:84px;
    user-select:none;
    -webkit-user-select:none;
    touch-action:none;
    pointer-events:auto;
  }

  .reibox-cluster.actions{
    width:88px;
    height:84px;
  }

  .reibox-wrap button.reibox-btn,
  .reibox-wrap .reibox-restart{
    font-family:'Courier New', monospace;
  }

  .reibox-btn{
    position:absolute;
    display:flex;
    align-items:center;
    justify-content:center;
    width:30px;
    height:30px;
    border-radius:50%;
    background:rgba(25,27,31,0.48);
    border:1px solid rgba(255,255,255,0.28);
    color:#f4f4f4;
    font-size:.68rem;
    font-weight:700;
    box-shadow:0 2px 0 rgba(0,0,0,0.22);
    -webkit-tap-highlight-color:transparent;
    backdrop-filter:blur(2px);
  }

  .reibox-btn:active,
  .reibox-btn.reibox-active{
    background:rgba(30,31,34,0.68);
    box-shadow:0 1px 0 rgba(0,0,0,0.28);
    transform:translateY(2px);
  }

  /* Small PS-style D-pad: A/D are still usable for double-tap dash. */
  .reibox-move{
    width:30px;
    height:30px;
    border-radius:9px;
    font-size:.82rem;
  }
  .reibox-move.left{  left:0;  bottom:38px; }
  .reibox-move.right{ left:36px; bottom:38px; }

  /* Removed dedicated DASH button: double-tap A/D triggers dash. */

  /* PS4-style face buttons: Square=Attack, Triangle=Heavy, Circle=Magic, X=Jump. */
   .reibox-punch{
    left:0;
    top:12px;
    border-radius:11px;
    background:rgba(90,35,35,0.48);
  }

  .reibox-heavy{
    left:0;
    top:0;
    background:rgba(108,62,24,0.50);
    border-color:rgba(255,210,120,0.48);
  }
  .reibox-heavy.reibox-active{
    background:rgba(150,78,20,0.96);
  }

  .reibox-magic{
    left:0;
    top:0;
    background:rgba(84,34,126,0.52);
    border-color:rgba(220,160,255,0.58);
    color:#f7eaff;
  }
  .reibox-magic.reibox-active{
    background:rgba(124,48,190,0.98);
  }

  .reibox-jump{
    left:40px;
    top:12px;
    background:rgba(34,52,79,0.48);
  }


   .reibox-top-actions .reibox-heavy,
  .reibox-top-actions .reibox-magic{
    width:34px;
    height:34px;
    font-size:.82rem;
    pointer-events:auto;
  }

  .reibox-face-symbol{
    font-size:.92rem;
    line-height:1;
  }

  .reibox-face-label{
    position:absolute;
    inset:auto 0 3px;
    text-align:center;
    font-size:.5rem;
    font-weight:700;
    opacity:.82;
    pointer-events:none;
  }

</style>
</head>

<div class="reibox-wrap">
  <div class="reibox-frame">
    <canvas id="reibox-ring" width="780" height="360"></canvas>

    <div class="reibox-hud">
      <div class="reibox-bar p1">
        <div class="reibox-track"><div class="reibox-fill reibox-fill-p1" id="reibox-hp1" style="width:100%"></div></div>
      </div>
      <span id="reibox-timer">60</span>
      <div class="reibox-bar p2">
        <div class="reibox-track"><div class="reibox-fill reibox-fill-p2" id="reibox-hp2" style="width:100%"></div></div>
      </div>
    </div>

    <div class="reibox-msg">
      <p class="reibox-text" id="reibox-msg"></p>
      <button class="reibox-restart" id="reibox-restartBtn">Fight again</button>
    </div>

    <div class="reibox-top-actions">
      <button type="button" class="reibox-btn reibox-heavy" data-key="e" aria-label="Heavy">△<span class="reibox-face-label">HEAVY</span></button>
      <button type="button" class="reibox-btn reibox-magic" data-key="q" aria-label="Magic">○<span class="reibox-face-label">MAGIC</span></button>
    </div>

    <div class="reibox-touch">
      <div class="reibox-cluster">
        <button type="button" class="reibox-btn reibox-move left"  data-key="a" aria-label="Left">◀</button>
        <button type="button" class="reibox-btn reibox-move right" data-key="d" aria-label="Right">▶</button>
      </div>
      <div class="reibox-cluster actions">
        <button type="button" class="reibox-btn reibox-punch" data-key="w" aria-label="Attack">□<span class="reibox-face-label">ATTACK</span></button>
        <button type="button" class="reibox-btn reibox-jump"  data-key="s" aria-label="Jump">✕<span class="reibox-face-label">JUMP</span></button>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  const canvas = document.getElementById('reibox-ring');
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const GROUND = H - 60;

  const hp1El = document.getElementById('reibox-hp1');
  const hp2El = document.getElementById('reibox-hp2');
  const timerEl = document.getElementById('reibox-timer');
  const msgEl = document.getElementById('reibox-msg');
  const restartBtn = document.getElementById('reibox-restartBtn');

  const PUNCH_RANGE = 70;
  const PUNCH_COOLDOWN = 32;   // frames
  const PUNCH_ACTIVE = 8;      // frames the fist is "out"
  const PUNCH_DAMAGE = 9;

  // ---- Heavy attack combo ----
  // Animation is timed in a 400 FPS clock so the combo has the same "weight"
  // even on 60 Hz displays. Each supplied sprite is deliberately held for
  // several 400-FPS ticks so the motion is slower and easier to feel.
  const HEAVY_FPS = 800;
  const HEAVY_FRAME_MS = 1000 / HEAVY_FPS;
  const HEAVY_DRAW_H = 116;
  const HEAVY_FRAME_HOLDS = [180,155,155,125,104,104,104,104,104,104,104,104,104,104,104,104,104,200,235];
  const HEAVY_HIT_FRAMES = [5, 9, 18]; // sprite indices 6, 10 and 23
  const HEAVY_HIT_DAMAGE = [10, 14, 24];
  const HEAVY_RANGE = 96;
  const HEAVY_COOLDOWN = 30; // 400-FPS ticks after the combo finishes
  const HEAVY_TOTAL_TICKS = HEAVY_FRAME_HOLDS.reduce((a, b) => a + b, 0);

  // ---- Heavy magic ----
  // 60 FPS timing, 4 deliberate poses, about 1 second total.
  // 1 = wind-up, 2 = slash, 3 = slash finishing, 4 = held pose with no slash.
  const MAGIC_FPS = 60;
  const MAGIC_FRAME_MS = 1000 / MAGIC_FPS;
  const MAGIC_DRAW_H = 118;
  const MAGIC_FRAME_HOLDS = [12, 18, 20, 10];
  const MAGIC_HIT_FRAMES = [1, 2];
  const MAGIC_HIT_DAMAGE = [18, 30];
  const MAGIC_RANGE = 118;
  const MAGIC_COOLDOWN = 50;
  const MAGIC_TOTAL_TICKS = MAGIC_FRAME_HOLDS.reduce((a, b) => a + b, 0);

  const MOVE_SPEED = 3.4;
  const ROUND_SECONDS = 60;
  const JUMP_FORCE = -9.5;
  const GRAVITY = 0.55;
  const DODGE_HEIGHT = 12;     // airborne past this height dodges punches
  const DASH_SPEED = 10;
  const DASH_FRAMES = 9;       // how long the dash burst lasts
  const DASH_COOLDOWN = 42;
  const DASH_TAP_WINDOW = 260; // ms between taps to count as a double-tap

  // ---- Sprite assets: walking sheet added from the supplied walking frames ----
  const WALKING_SPRITE = "data:image/png;base64,";
  const WALK_FRAME_W = 180;
  const WALK_FRAME_H = 360;
  const WALK_FRAMES = 4;
  const WALK_FRAME_SPEED = 6;

  // ---- Added jump frames from the supplied double-jump sheet ----
  // First jump uses the single airborne frame. A second jump click while airborne
  // starts the 8-frame double-jump + landing sequence.
  const SINGLE_JUMP_SPRITE = "data:image/png;base64,";
  const DOUBLE_JUMP_SPRITE = "data:image/png;base64,";

  // Cropped from the supplied 1-23 heavy-attack sheet; background is transparent.
  const HEAVY_SPRITES = [
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,"
  ];

  const SPRITE_SOURCES = {
    singleJump: SINGLE_JUMP_SPRITE,
    doubleJump: DOUBLE_JUMP_SPRITE,
    walking: WALKING_SPRITE,
    idleOld:  "data:image/png;base64,",
    punch: "data:image/png;base64,",
    jump:  "data:image/png;base64,",
    dash:  "data:image/png;base64,"
  };
  const SPRITE_DRAW_H = 108;
  const JUMP_FRAME_W = 256;
  const JUMP_FRAME_H = 312;
  const DOUBLE_JUMP_FRAMES = 8;
  const DOUBLE_JUMP_FRAME_SPEED = 5;     // on-screen sprite height in px, all poses scaled to match

  const sprites = {};
  let spritesReady = false;

  (function preloadSprites(){
    const names = Object.keys(SPRITE_SOURCES);
    let loaded = 0;
    names.forEach((name) => {
      const img = new Image();
      img.onload = () => {
        loaded++;
        if (loaded === names.length) spritesReady = true;
      };
      img.src = SPRITE_SOURCES[name];
      sprites[name] = img;
    });
  })();

  const heavySprites = [];
  let heavySpritesReady = false;
  const magicSprites = [];
  let magicSpritesReady = false;

  const MAGIC_SPRITES = [
        "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,",
    "data:image/png;base64,"
  ];
  (function preloadHeavySprites(){
    let loaded = 0;
    HEAVY_SPRITES.forEach((src, i) => {
      const img = new Image();
      img.onload = () => {
        loaded++;
        if (loaded === HEAVY_SPRITES.length) heavySpritesReady = true;
      };
      img.src = src;
      heavySprites[i] = img;
    });
  })();
  (function preloadMagicSprites(){
    let loaded = 0;
    MAGIC_SPRITES.forEach((src, i) => {
      const img = new Image();
      img.onload = () => {
        loaded++;
        if (loaded === MAGIC_SPRITES.length) magicSpritesReady = true;
      };
      img.src = src;
      magicSprites[i] = img;
    });
  })();

  let gameOver = false;
  let frame = 0;
  let secondsLeft = ROUND_SECONDS;
  let lastTickTime = performance.now();

  function makeFighter(x, color, facing) {
    return {
      x, y: GROUND, w: 40, h: 76,
      color, facing,           // 1 = facing right, -1 = facing left
      hp: 100,
      punching: 0,             // frames remaining of active punch
      cooldown: 0,
      heavyActive: false,
      heavyFrame: 0,
      heavyTick: 0,
      heavyElapsed: 0,
      heavyHitMask: 0,
      heavyCooldown: 0,
      heavyLastTime: 0,
      magicActive: false,
      magicFrame: 0,
      magicTick: 0,
      magicElapsed: 0,
      magicHitMask: 0,
      magicCooldown: 0,
      magicLastTime: 0,
      hitFlash: 0,
      stagger: 0,
      jumpOffset: 0,           // 0 = grounded, negative = in the air
      vy: 0,
      isJumping: false,
      dashFrames: 0,           // frames remaining in the current dash burst
      dashDir: 0,
      dashCooldown: 0,
      walking: false,
      walkFrame: 0,
      walkTick: 0,
      jumpCount: 0,
      doubleJumping: false,
      doubleJumpFrame: 0,
      doubleJumpTick: 0,
      landingFrames: 0,
    };
  }

  const p1 = makeFighter(220, '#e0555a', 1);
  const p2 = makeFighter(560, '#4f8ff0', -1);

  const keys = {};
  const lastTapTime = { a: 0, d: 0 };
  let jumpPressed = false;

  function tryStartDash(f, dir) {
    if (f.dashCooldown > 0 || f.dashFrames > 0 || f.stagger > 0) return;
    f.dashFrames = DASH_FRAMES;
    f.dashDir = dir;
    f.dashCooldown = DASH_COOLDOWN;
  }

  function checkDoubleTap(k) {
    if (k !== 'a' && k !== 'd') return;
    const now = performance.now();
    if (now - lastTapTime[k] <= DASH_TAP_WINDOW) {
      tryStartDash(p1, k === 'a' ? -1 : 1);
    }
    lastTapTime[k] = now;
  }

  window.addEventListener('keydown', (e) => {
    const k = e.key.toLowerCase();
    if (['w','a','s','d','e','q'].includes(k)) {
      if (['a','d'].includes(k) && !keys[k]) checkDoubleTap(k);
      if (k === 's' && !keys[k]) jumpPressed = true;
      if (k === 'e' && !keys[k]) startHeavyAttack(p1);
      if (k === 'q' && !keys[k]) startMagicAttack(p1);
      keys[k] = true;
      e.preventDefault();
    }
  });
  window.addEventListener('keyup', (e) => {
    const k = e.key.toLowerCase();
    if (['w','a','s','d','e','q'].includes(k)) {
      keys[k] = false;
    }
  });


  // ---- Touch / on-screen controls ----
  // Same "keys" object as the keyboard, so movement/punch/jump/dash logic is untouched.
  document.querySelectorAll('.reibox-btn').forEach((btn) => {
    const k = btn.getAttribute('data-key');

    const press = (e) => {
      e.preventDefault();
      if (k === 'dash') {
        tryStartDash(p1, p1.facing);
      } else if (k === 'e') {
        startHeavyAttack(p1);
      } else if (k === 'q') {
        startMagicAttack(p1);
      } else {
        if (['a','d'].includes(k) && !keys[k]) checkDoubleTap(k);
        if (k === 's' && !keys[k]) jumpPressed = true;
        keys[k] = true;
      }
      btn.classList.add('reibox-active');
    };
    const release = (e) => {
      e.preventDefault();
      if (k !== 'dash') keys[k] = false;
      btn.classList.remove('reibox-active');
    };

    btn.addEventListener('touchstart', press, { passive: false });
    btn.addEventListener('touchend', release, { passive: false });
    btn.addEventListener('touchcancel', release, { passive: false });

    // also works with mouse, e.g. touchscreen laptops / testing on desktop
    btn.addEventListener('mousedown', press);
    btn.addEventListener('mouseup', release);
    btn.addEventListener('mouseleave', release);
  });

  window.addEventListener('blur', () => {
    Object.keys(keys).forEach((k) => keys[k] = false);
    document.querySelectorAll('.reibox-btn').forEach((btn) => btn.classList.remove('reibox-active'));
  });

  restartBtn.addEventListener('click', resetMatch);

  function resetMatch() {
    p1.x = 220; p1.hp = 100; p1.jumpCount = 0; p1.doubleJumping = false; p1.doubleJumpFrame = 0; p1.doubleJumpTick = 0; p1.landingFrames = 0; p1.cooldown = 0; p1.punching = 0; p1.heavyActive = false; p1.heavyFrame = 0; p1.heavyTick = 0; p1.heavyElapsed = 0; p1.heavyHitMask = 0; p1.heavyCooldown = 0; p1.heavyLastTime = 0; p1.magicActive = false; p1.magicFrame = 0; p1.magicTick = 0; p1.magicElapsed = 0; p1.magicHitMask = 0; p1.magicCooldown = 0; p1.magicLastTime = 0; p1.hitFlash = 0; p1.stagger = 0; p1.jumpOffset = 0; p1.vy = 0; p1.isJumping = false; p1.dashFrames = 0; p1.dashCooldown = 0;
    p2.x = 560; p2.hp = 100; p2.jumpCount = 0; p2.doubleJumping = false; p2.doubleJumpFrame = 0; p2.doubleJumpTick = 0; p2.landingFrames = 0; p2.cooldown = 0; p2.punching = 0; p2.hitFlash = 0; p2.stagger = 0; p2.jumpOffset = 0; p2.vy = 0; p2.isJumping = false; p2.dashFrames = 0; p2.dashCooldown = 0;
    secondsLeft = ROUND_SECONDS;
    lastTickTime = performance.now();
    gameOver = false;
    msgEl.textContent = '';
    restartBtn.style.display = 'none';
    updateBars();
  }

  function updateBars() {
    hp1El.style.width = Math.max(0, p1.hp) + '%';
    hp2El.style.width = Math.max(0, p2.hp) + '%';
  }

  function distanceBetween() {
    return Math.abs((p1.x) - (p2.x));
  }

  function tryLandPunch(attacker, defender) {
    if (attacker.punching !== PUNCH_ACTIVE) return; // only checks on the frame the swing starts
    const dist = distanceBetween();
    const facingRight = attacker.facing === 1 ? attacker.x < defender.x : attacker.x > defender.x;
    if (dist <= PUNCH_RANGE && facingRight) {
      if (defender.jumpOffset <= -DODGE_HEIGHT || defender.dashFrames > 0) return; // dodged
      defender.hp -= PUNCH_DAMAGE;
      defender.hitFlash = 8;
      defender.stagger = 8;
    }
  }

  function startJump(f) {
    // First click: normal jump.
    if (!f.isJumping && !f.doubleJumping && f.landingFrames === 0) {
      f.isJumping = true;
      f.jumpCount = 1;
      f.vy = JUMP_FORCE;
      return;
    }

    // Second click while airborne: double jump + landing sequence.
    if (f.isJumping && f.jumpCount === 1 && !f.doubleJumping) {
      f.jumpCount = 2;
      f.doubleJumping = true;
      f.doubleJumpFrame = 0;
      f.doubleJumpTick = 0;
      f.vy = -8.4;
    }
  }

  function applyJumpPhysics(f) {
    if (f.isJumping) {
      f.vy += GRAVITY;
      f.jumpOffset += f.vy;
      if (f.jumpOffset >= 0) {
        f.jumpOffset = 0;
        f.vy = 0;
        f.isJumping = false;
        f.jumpCount = 0;
        f.doubleJumping = false;
        f.doubleJumpFrame = 0;
        f.doubleJumpTick = 0;
      }
    }

    if (f.landingFrames > 0 && !f.doubleJumping) {
      f.landingFrames--;
    }

    if (f.doubleJumping) {
      f.doubleJumpTick++;
      if (f.doubleJumpTick >= DOUBLE_JUMP_FRAME_SPEED) {
        f.doubleJumpTick = 0;
        f.doubleJumpFrame++;

        // The 8th supplied frame is the landing pose. Finish on that frame
        // instead of snapping back to the old jump sprite.
        if (f.doubleJumpFrame >= DOUBLE_JUMP_FRAMES) {
          f.doubleJumpFrame = DOUBLE_JUMP_FRAMES - 1;
          f.jumpOffset = 0;
          f.vy = 0;
          f.isJumping = false;
          f.jumpCount = 0;
          f.doubleJumping = false;
          f.landingFrames = 8;
          f.doubleJumpTick = 0;
        }
      }
    }
  }

  function startHeavyAttack(f) {
    if (
      gameOver ||
      f.heavyActive ||
      f.heavyCooldown > 0 ||
      f.punching > 0 ||
      f.dashFrames > 0 ||
      f.stagger > 0 ||
      f.isJumping
    ) return;

    f.heavyActive = true;
    f.heavyFrame = 0;
    f.heavyTick = 0;
    f.heavyElapsed = 0;
    f.heavyHitMask = 0;
    f.heavyLastTime = performance.now();
    f.walking = false;
    f.cooldown = Math.max(f.cooldown, HEAVY_COOLDOWN);
  }

  function heavyFrameAtTick(tick) {
    let acc = 0;
    for (let i = 0; i < HEAVY_FRAME_HOLDS.length; i++) {
      acc += HEAVY_FRAME_HOLDS[i];
      if (tick < acc) return i;
    }
    return HEAVY_FRAME_HOLDS.length - 1;
  }

  function tryLandHeavyHits(attacker, defender) {
    const idx = attacker.heavyFrame;
    const hitSlot = HEAVY_HIT_FRAMES.indexOf(idx);
    if (hitSlot < 0) return;

    const bit = 1 << hitSlot;
    if (attacker.heavyHitMask & bit) return;

    // Mark it before checking range so a long-held animation frame cannot
    // apply the same hit more than once.
    attacker.heavyHitMask |= bit;

    const dist = distanceBetween();
    const facingRight = attacker.facing === 1
      ? attacker.x < defender.x
      : attacker.x > defender.x;

    if (dist > HEAVY_RANGE || !facingRight) return;
    if (defender.jumpOffset <= -DODGE_HEIGHT || defender.dashFrames > 0) return;

    defender.hp -= HEAVY_HIT_DAMAGE[hitSlot];
    defender.hitFlash = 10;
    defender.stagger = hitSlot === 2 ? 16 : 10;

    // Small forward pull on each heavy hit so the combo feels connected.
    attacker.x += attacker.facing * (hitSlot === 2 ? 7 : 4);
  }

  function updateHeavyAttack(f) {
    if (f.heavyCooldown > 0) f.heavyCooldown--;

    if (!f.heavyActive) return;

    f.walking = false;
    const now = performance.now();
    f.heavyElapsed += now - (f.heavyLastTime || now);
    f.heavyLastTime = now;

    // Advance using a real-time 400 FPS clock rather than assuming the
    // browser renders at 340 Hz.
    while (f.heavyElapsed >= HEAVY_FRAME_MS) {
      f.heavyElapsed -= HEAVY_FRAME_MS;
      f.heavyTick++;

      if (f.heavyTick >= HEAVY_TOTAL_TICKS) {
        f.heavyActive = false;
        f.heavyFrame = 0;
        f.heavyTick = 0;
        f.heavyElapsed = 0;
        f.heavyHitMask = 0;
        f.heavyCooldown = HEAVY_COOLDOWN;
        return;
      }

      f.heavyFrame = heavyFrameAtTick(f.heavyTick);
    }
  }

  function startMagicAttack(f) {
    if (
      gameOver ||
      f.magicActive ||
      f.magicCooldown > 0 ||
      f.heavyActive ||
      f.punching > 0 ||
      f.dashFrames > 0 ||
      f.stagger > 0 ||
      f.isJumping
    ) return;

    f.magicActive = true;
    f.magicFrame = 0;
    f.magicTick = 0;
    f.magicElapsed = 0;
    f.magicHitMask = 0;
    f.magicLastTime = performance.now();
    f.walking = false;
  }

  function magicFrameAtTick(tick) {
    let acc = 0;
    for (let i = 0; i < MAGIC_FRAME_HOLDS.length; i++) {
      acc += MAGIC_FRAME_HOLDS[i];
      if (tick < acc) return i;
    }
    return MAGIC_FRAME_HOLDS.length - 1;
  }

  function tryLandMagicHits(attacker, defender) {
    const idx = attacker.magicFrame;
    const hitSlot = MAGIC_HIT_FRAMES.indexOf(idx);
    if (hitSlot < 0) return;

    const bit = 1 << hitSlot;
    if (attacker.magicHitMask & bit) return;
    attacker.magicHitMask |= bit;

    const dist = Math.abs(attacker.x - defender.x);
    const facingRight = attacker.facing === 1
      ? attacker.x < defender.x
      : attacker.x > defender.x;

    if (dist > MAGIC_RANGE || !facingRight) return;
    if (defender.jumpOffset <= -DODGE_HEIGHT || defender.dashFrames > 0) return;

    defender.hp -= MAGIC_HIT_DAMAGE[hitSlot];
    defender.hitFlash = 12;
    defender.stagger = hitSlot === 1 ? 18 : 12;
  }

  function updateMagicAttack(f) {
    if (f.magicCooldown > 0) f.magicCooldown--;
    if (!f.magicActive) return;

    const now = performance.now();
    f.magicElapsed += now - (f.magicLastTime || now);
    f.magicLastTime = now;

    while (f.magicElapsed >= MAGIC_FRAME_MS) {
      f.magicElapsed -= MAGIC_FRAME_MS;
      f.magicTick++;

      if (f.magicTick >= MAGIC_TOTAL_TICKS) {
        f.magicActive = false;
        f.magicFrame = 3;
        f.magicTick = 0;
        f.magicElapsed = 0;
        f.magicHitMask = 0;
        f.magicCooldown = MAGIC_COOLDOWN;
        return;
      }

      f.magicFrame = magicFrameAtTick(f.magicTick);
    }
  }

  // ---- Player control ----
  function updatePlayer() {
    updateMagicAttack(p1);
    updateHeavyAttack(p1);

    if (p1.dashCooldown > 0) p1.dashCooldown--;

    if (p1.magicActive) {
      // Movement remains available throughout the magic animation.
      p1.walking = false;
      if (keys['a']) { p1.x -= MOVE_SPEED * 0.9; p1.facing = -1; p1.walking = true; }
      if (keys['d']) { p1.x += MOVE_SPEED * 0.9; p1.facing = 1; p1.walking = true; }
      if (!keys['a'] && !keys['d']) p1.facing = p1.x < p2.x ? 1 : -1;
      tryLandMagicHits(p1, p2);
      p1.x = Math.max(40, Math.min(W - 40, p1.x));
      return;
    }

    if (p1.heavyActive) {
      p1.walking = false;
      p1.facing = p1.x < p2.x ? 1 : -1;
      tryLandHeavyHits(p1, p2);
      p1.x = Math.max(40, Math.min(W - 40, p1.x));
      return;
    }

    if (p1.dashFrames > 0) {
        p1.x += DASH_SPEED * p1.dashDir;
      p1.dashFrames--;
    } else if (p1.stagger > 0) {
        p1.stagger--;
    } else {
      p1.walking = false;
      if (keys['a']) { p1.x -= MOVE_SPEED; p1.walking = true; }
      if (keys['d']) { p1.x += MOVE_SPEED; p1.walking = true; }

      if (p1.walking && !p1.isJumping) {
        p1.walkTick++;
        if (p1.walkTick >= WALK_FRAME_SPEED) {
          p1.walkTick = 0;
          p1.walkFrame = (p1.walkFrame + 1) % WALK_FRAMES;
        }
      } else if (!p1.walking) {
        p1.walkFrame = 0;
        p1.walkTick = 0;
      }
    }

    p1.facing = p1.x < p2.x ? 1 : -1;

    if (jumpPressed) {
      startJump(p1);
      jumpPressed = false;
    }
    applyJumpPhysics(p1);

    if (p1.cooldown > 0) p1.cooldown--;
    if (p1.punching > 0) p1.punching--;

    if (keys['w'] && p1.cooldown === 0 && p1.dashFrames === 0 && !p1.heavyActive && !p1.magicActive && p1.heavyCooldown === 0 && p1.magicCooldown === 0) {
      p1.punching = PUNCH_ACTIVE;
      p1.cooldown = PUNCH_COOLDOWN;
    }

    tryLandPunch(p1, p2);

    p1.x = Math.max(40, Math.min(W - 40, p1.x));
  }

  // ---- Simple AI opponent ----
  let aiState = 'approach';
  let aiTimer = 0;

  function updateAI() {
    if (p2.dashCooldown > 0) p2.dashCooldown--;

    if (p2.dashFrames > 0) {
      p2.x += DASH_SPEED * p2.dashDir;
      p2.dashFrames--;
    } else if (p2.stagger > 0) {
      p2.stagger--;
    }

    p2.facing = p2.x < p1.x ? 1 : -1;

    if (p2.cooldown > 0) p2.cooldown--;
    if (p2.punching > 0) p2.punching--;

    aiTimer--;
    if (aiTimer <= 0) {
      const dist = distanceBetween();
      const roll = Math.random();

      if (dist > PUNCH_RANGE + 10) {
        aiState = 'approach';
      } else if (dist < PUNCH_RANGE - 30) {
        aiState = roll < 0.4 ? 'retreat' : 'attack';
      } else {
        aiState = roll < 0.55 ? 'attack' : (roll < 0.8 ? 'jump' : 'retreat');
      }
      aiTimer = 18 + Math.floor(Math.random() * 30);
    }

    applyJumpPhysics(p2);

    // dodge a punch that's about to land, sometimes — jump or backdash
    if (p1.punching > 0 && p1.punching < PUNCH_ACTIVE && distanceBetween() <= PUNCH_RANGE + 10) {
      const dodgeRoll = Math.random();
      if (dodgeRoll < 0.05) startJump(p2);
      else if (dodgeRoll < 0.10) tryStartDash(p2, p2.x > p1.x ? 1 : -1);
    }

    p2.walking = false;
    if (p2.stagger === 0 && p2.dashFrames === 0) {
      if (aiState === 'approach') {
        p2.walking = true;
        p2.x += (p2.x > p1.x ? -1 : 1) * MOVE_SPEED * 0.9;
      } else if (aiState === 'retreat') {
        p2.walking = true;
        p2.x += (p2.x > p1.x ? 1 : -1) * MOVE_SPEED * 0.8;
      } else if (aiState === 'jump') {
        startJump(p2);
      } else if (aiState === 'attack') {
        const dist = distanceBetween();
        if (dist <= PUNCH_RANGE + 6 && p2.cooldown === 0) {
          p2.punching = PUNCH_ACTIVE;
          p2.cooldown = PUNCH_COOLDOWN + 6;
        } else if (dist > PUNCH_RANGE) {
          p2.walking = true;
          p2.x += (p2.x > p1.x ? -1 : 1) * MOVE_SPEED * 0.9;
        }
      }
    }

    if (p2.walking && !p2.isJumping) {
      p2.walkTick++;
      if (p2.walkTick >= WALK_FRAME_SPEED) {
        p2.walkTick = 0;
        p2.walkFrame = (p2.walkFrame + 1) % WALK_FRAMES;
      }
    } else if (!p2.walking) {
      p2.walkFrame = 0;
      p2.walkTick = 0;
    }

    tryLandPunch(p2, p1);

    p2.x = Math.max(40, Math.min(W - 40, p2.x));
  }

  function checkRoundEnd() {
    if (gameOver) return;
    if (p1.hp <= 0 || p2.hp <= 0) {
      gameOver = true;
      if (p1.hp <= 0 && p2.hp <= 0) msgEl.textContent = 'Double knockout';
      else if (p1.hp <= 0) msgEl.textContent = 'CPU wins by KO';
      else msgEl.textContent = 'You win by KO';
      restartBtn.style.display = 'inline-block';
    } else if (secondsLeft <= 0) {
      gameOver = true;
      if (p1.hp > p2.hp) msgEl.textContent = 'You win on points';
      else if (p2.hp > p1.hp) msgEl.textContent = 'CPU wins on points';
      else msgEl.textContent = 'Draw';
      restartBtn.style.display = 'inline-block';
    }
  }

  function updateTimer(now) {
    if (gameOver) return;
    if (now - lastTickTime >= 1000) {
      lastTickTime = now;
      secondsLeft = Math.max(0, secondsLeft - 1);
      timerEl.textContent = secondsLeft;
    }
  }

  // ---- Drawing ----
  function drawRing() {
    ctx.fillStyle = '#e8e4da';
    ctx.fillRect(0, 0, W, H);

    // canvas mat
    ctx.fillStyle = '#d8d2c2';
    ctx.fillRect(0, GROUND, W, H - GROUND);

    // mat lines
    ctx.strokeStyle = '#c7c0ac';
    ctx.lineWidth = 1;
    for (let x = 0; x <= W; x += 30) {
      ctx.beginPath();
      ctx.moveTo(x, GROUND);
      ctx.lineTo(x, H);
      ctx.stroke();
    }

    // ropes
    ctx.strokeStyle = '#c0524f';
    ctx.lineWidth = 3;
    [0.28, 0.4, 0.52].forEach((f) => {
      ctx.beginPath();
      ctx.moveTo(0, GROUND * f);
      ctx.lineTo(W, GROUND * f);
      ctx.stroke();
    });

    // corner posts
    ctx.fillStyle = '#b3453f';
    ctx.fillRect(6, GROUND * 0.22, 10, GROUND * 0.8);
    ctx.fillRect(W - 16, GROUND * 0.22, 10, GROUND * 0.8);
  }

  function pickPose(f) {
    if (f.magicActive) return 'magic';
    if (f.heavyActive) return 'heavy';
    if (f.punching > 0) return 'punch';
    if (f.dashFrames > 0) return 'dash';
    if (f.doubleJumping || f.landingFrames > 0) return 'doubleJump';
    if (f.isJumping || f.jumpOffset < 0) return 'singleJump';
    if (f.walking) return 'walking';
    return 'idleOld';
  }

  function drawFighter(f, isRival) {
    // shadow (shrinks and fades the higher the jump)
    const airFactor = Math.min(1, -f.jumpOffset / 60);
    ctx.fillStyle = 'rgba(0,0,0,' + (0.18 * (1 - airFactor * 0.7)) + ')';
    ctx.beginPath();
    ctx.ellipse(f.x, f.y + 6, 22 * (1 - airFactor * 0.4), 7 * (1 - airFactor * 0.4), 0, 0, Math.PI * 2);
    ctx.fill();

    // dash trail — a few faded afterimages behind the movement
    if (f.dashFrames > 0 && spritesReady) {
      const img = sprites.dash;
      const ratio = img.width / img.height;
      const dh = SPRITE_DRAW_H, dw = dh * ratio;
      for (let i = 1; i <= 3; i++) {
        ctx.save();
        ctx.globalAlpha = 0.10 * (4 - i);
        const trailX = f.x - f.dashDir * i * 10;
        const trailY = f.y + f.jumpOffset;
        ctx.translate(trailX, trailY);
        if (f.facing === -1) ctx.scale(-1, 1);
        ctx.drawImage(img, -dw / 2, -dh, dw, dh);
        ctx.restore();
      }
    }

    const bob = f.stagger > 0 ? Math.sin(frame * 0.9) * 3 : 0;
    const baseX = f.x;
    const baseY = f.y + bob + f.jumpOffset;

    if (!spritesReady) {
      // simple placeholder box while the sprite sheet loads
      ctx.fillStyle = f.color;
      ctx.fillRect(baseX - 16, baseY - 70, 32, 70);
      return;
    }

    const pose = pickPose(f);
    const img = pose === 'magic' ? magicSprites[f.magicFrame] : (pose === 'heavy' ? heavySprites[f.heavyFrame] : sprites[pose]);

    ctx.save();

    const flashOn = f.hitFlash > 0 && Math.floor(f.hitFlash / 2) % 2 === 0;
    if (f.hitFlash > 0) f.hitFlash--;

    let filter = '';
    if (isRival) filter += 'hue-rotate(205deg) saturate(1.15) ';
    if (flashOn) filter += 'brightness(2.4) saturate(0.3)';
    if (filter) ctx.filter = filter.trim();

    ctx.translate(baseX, baseY);
    if (f.facing === -1) ctx.scale(-1, 1);

    if (pose === 'magic') {
      if (magicSpritesReady && img) {
        const dh = MAGIC_DRAW_H;
        const dw = dh * (img.width / img.height);
        ctx.drawImage(img, -dw / 2, -dh, dw, dh);
      }
    } else if (pose === 'heavy') {
      if (heavySpritesReady && img) {
        const dh = HEAVY_DRAW_H;
        const dw = dh * (img.width / img.height);
        ctx.drawImage(img, -dw / 2, -dh, dw, dh);
      }
    } else if (pose === 'walking') {
      const dh = SPRITE_DRAW_H;
      const dw = dh * (WALK_FRAME_W / WALK_FRAME_H);
      ctx.drawImage(
        img,
        f.walkFrame * WALK_FRAME_W, 0, WALK_FRAME_W, WALK_FRAME_H,
        -dw / 2, -dh, dw, dh
      );
    } else if (pose === 'singleJump') {
      const dh = SPRITE_DRAW_H;
      const dw = dh * (img.width / img.height);
      ctx.drawImage(img, -dw / 2, -dh, dw, dh);
    } else if (pose === 'doubleJump') {
      const dh = SPRITE_DRAW_H * 1.16;
      const dw = dh * (JUMP_FRAME_W / JUMP_FRAME_H);
      ctx.drawImage(
        img,
        (f.doubleJumpFrame % 4) * JUMP_FRAME_W,
        Math.floor(f.doubleJumpFrame / 4) * JUMP_FRAME_H,
        JUMP_FRAME_W, JUMP_FRAME_H,
        -dw / 2, -dh, dw, dh
      );
    } else {
      const ratio = img.width / img.height;
      const dh = SPRITE_DRAW_H, dw = dh * ratio;
      ctx.drawImage(img, -dw / 2, -dh, dw, dh);
    }

    ctx.restore();
  }

  function draw() {
    drawRing();
    drawFighter(p1, false);
    drawFighter(p2, true);
  }

  function loop(now) {
    frame++;
    if (!gameOver) {
      updatePlayer();
      updateAI();
      updateBars();
      updateTimer(now);
      checkRoundEnd();
    }
    draw();
    requestAnimationFrame(loop);
  }

  updateBars();
  requestAnimationFrame(loop);
})();
</script>
